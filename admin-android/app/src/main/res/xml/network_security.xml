<?xml version="1.0" encoding="utf-8"?>
<!--
     برنامه‌ی مدیریت هم فقط HTTPS.

     این برنامه توکن مدیر را حمل می‌کند؛ همان توکنی که با آن می‌شود
     اشتراک هر کسی را عوض کرد. روی `http` ساده فرستادنش یعنی هر کسی روی
     همان شبکه می‌تواند برش دارد.

     نسخه‌ی آزمایشی پرونده‌ی خودش را دارد.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
