<?xml version="1.0" encoding="utf-8"?>
<!--
     دربارهٔ http.

     این برنامه توکنِ مدیر را حمل می‌کند و روی اینترنت نباید روی خطِ باز
     برود. ولی سرورِ خانگی روی ۱۹۲.۱۶۸.x می‌نشیند و https ندارد — برای یک
     آی‌پیِ داخلی گواهیِ معتبر صادر نمی‌شود. اگر اینجا http را ببندیم،
     برنامه در خانهٔ صاحبِ خودش کار نمی‌کند و هیچ‌کس هم امن‌تر نشده.

     پرونده‌ی network security config نمی‌تواند بگوید «فقط محدوده‌های
     خصوصی»؛ فقط نام‌های مشخص را می‌پذیرد. پس اجازه اینجا باز است و خودِ
     قاعده در کد نوشته شده — AdminApi.normalizeBase — که http را فقط برای
     نشانیِ خانگی می‌پذیرد و برای هر نشانیِ دیگری رد می‌کند، با پیامی که
     می‌گوید چه کار کند. همان‌جا هم آزموده می‌شود.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
