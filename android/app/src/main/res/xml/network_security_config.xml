<?xml version="1.0" encoding="utf-8"?>
<!--
  سرور خانگی ممکن است http ساده روی IP محلی باشد.
  https همیشه مجاز است؛ http فقط وقتی کاربر خودش آدرس http بدهد.
  برای دسترسی از بیرون شبکه، https توصیه می‌شود (با هر روشی که دارید:
  گواهی روی خود سرور، Nginx، یا هر تونل امن).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
