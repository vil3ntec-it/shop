<?xml version="1.0" encoding="utf-8"?>
<!--
  پشتیبانِ خودکارِ اندروید ۱۱ و پایین‌تر (و `adb backup`).

  `app_webview` (localStorage و IndexedDB ِ صفحه، با توکنِ ورود) بیرون
  می‌ماند؛ دلیل در `data_extraction_rules.xml` آمده است. `allowBackup`
  در مانیفست هم خاموش است، پس این پرونده لایهٔ دوم است.
-->
<full-backup-content>
    <exclude domain="root" path="app_webview" />
</full-backup-content>
