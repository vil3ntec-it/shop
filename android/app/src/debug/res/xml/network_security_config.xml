<?xml version="1.0" encoding="utf-8"?>
<!--
  فقط برای نسخهٔ آزمایشی (`af.tohid.shop.debug`): سرورِ روی رایانهٔ خودی
  معمولاً گواهی ندارد و پروکسیِ اشکال‌زدایی گواهیِ کاربر می‌خواهد. نسخهٔ
  انتشار پروندهٔ سخت‌گیرانهٔ `src/main` را دارد و این به دستِ کاربر نمی‌رسد.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
