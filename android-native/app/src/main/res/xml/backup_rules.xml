<?xml version="1.0" encoding="utf-8"?>
<!--
     پشتیبانِ خودکارِ اندروید (اندروید ۱۲ به بالا).

     دفترِ دکان و تنظیمات پشتیبان گرفته می‌شوند تا گوشیِ تازه با همان
     اطلاعات بالا بیاید. ولی توکنِ ورود نه: توکن مالِ همان دستگاه است و
     بردنش به دستگاهِ دیگر یعنی نشستنِ یک نشستِ باز روی گوشی‌ای که شاید
     مالِ کسِ دیگری باشد.

     `exclude` فقط زیرِ چیزی معنی دارد که `include` شده باشد — وگرنه
     ساخت رد می‌شود. برای همین `sharedpref` هم بالا آمده و بعد یک فایلش
     کنار گذاشته شده.

     `tohid-session*` جای توکنِ امروز است (`TokenStore`)؛ `tohid-sync`
     جای قدیمی‌اش. هر سه بیرون می‌مانند. `tohid-staff-pins` هم (اثرِ PIN و
     کلیدِ تأییدِ بسته — STF-02/04): مالِ همین دستگاه است و هرگز جابه‌جا نمی‌شود.
     `tohid-doc-series` (سریِ سندِ این دستگاه، F0-03) هم — DATA-06: گوشیِ دومی که از پشتیبانِ
     این گوشی بالا بیاید شناسهٔ دستگاهِ تازه می‌گیرد (`tohid-sync` بیرون است)، پس باید سریِ خودش را
     هم از سرور بگیرد؛ با سریِ همین گوشی و همان `nextInvoiceNo` ِ دفتر، هر دو «A1-155» می‌ساختند.
     `tohid-sync-v1` (DATA-06، ۱۴۰۵/۰۸/۱۸) هم: از #991 `replica` ِ هر حساب (`device_id` ِ push/pull و سریِ سند) و
     cursor ِ همان حساب آن‌جاست — گوشیِ دوم با آن همان شناسهٔ گوشیِ اول را به سرور می‌داد، و با شناسهٔ تازه ولی همان
     cursor opهای خودِ گوشیِ اول را دوباره روی دفتر می‌نشاند (موجودی و قرض دو بار). دفتر، صف و ژورنال (`file`)
     می‌روند؛ گوشیِ بازیابی‌شده با `V1Replica.fence` شناسهٔ خودش را می‌گیرد و پیش از هر Pull یک بار «بازسازی از
     سرور» می‌کند (صف اول) — `core/sync/RestoredDevice.kt`. قاعدهٔ همین فایل هنگامِ **بازیابی** هم بر پشتیبانِ کهنه‌تر
     اجرا می‌شود (`BackupAgent.onRestoreFile`)، پس پشتیبانِ نسخه‌های پیشین هم این پرونده را برنمی‌گرداند.
     پوشهٔ `sync-shadow/` (`file`) همان حالِ `tohid-sync-v1` است وقتی پرچمِ `shop.sync_shadow_file` روشن است
     (`sync/v1/ShadowStore`: سایه و cursor در فایلِ خودشان): نشانش با پشتیبان نمی‌رود، پس در گوشیِ بازیابی‌شده هیچ
     بکار نمی‌آمد، و فایلی هم‌اندازهٔ دفتر سقفِ ۲۵ مگیِ پشتیبانِ ابری را پر می‌کرد ⇒ بیرون.
     پوشهٔ `sync-v3/` (`file`، DATA-06) حالِ Sync v3 ِ هر حساب است (cursor، سایه، ساعتِ HLC، بستگی، ژورنال و دفترچهٔ
     §۹.۵ — `sync/v3/V3StateDirAndroid.kt`): cursor ِ گوشیِ اول روی گوشیِ دوم با شناسهٔ تازه opهای خودِ گوشیِ اول را
     دوباره می‌نشاند ⇒ بیرون. صفِ v3 (`sync-v3-<کلید>/queue.json`) مثلِ `oplog-*` ِ v1 می‌رود و گوشیِ دوم آن را اول
     می‌فرستد. ساخت‌های پیشین حال را هم در `sync-v3-<کلید>/` می‌گذاشتند (`exclude` الگو نمی‌پذیرد) ⇒ در نخستین خواندن
     به `sync-v3/` می‌رود؛ حالی که باز هم برسد (پشتیبانِ کهنه، رونوشتِ خام) را `V3Fence` می‌گیرد.

     SEC-01: وقتی «رمزگذاریِ دفتر» در کار است، `TohidBackupAgent` به‌جای این
     قاعده‌ها همان دو دامنه را می‌فرستد منهای دفترِ رمزدار، کلیددان و حالِ
     همگام‌سازی (هر سه با هم) — کلیدِ Keystore با پشتیبان نمی‌رود. استثناهای
     همین فایل (توکن‌ها، `tohid-staff-pins`، `tohid-doc-series`، `tohid-sync-v1`) آن‌جا هم بیرون‌اند.
-->
<data-extraction-rules>
  <cloud-backup>
    <include domain="file" path="." />
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="tohid-sync.xml" />
    <exclude domain="sharedpref" path="tohid-session.xml" />
    <exclude domain="sharedpref" path="tohid-session-secure.xml" />
    <exclude domain="sharedpref" path="tohid-staff-pins.xml" />
    <exclude domain="sharedpref" path="tohid-doc-series.xml" />
    <exclude domain="sharedpref" path="tohid-sync-v1.xml" />
    <exclude domain="sharedpref" path="tohid-backup-device.xml" />
    <exclude domain="file" path="sync-shadow" />
    <exclude domain="file" path="sync-v3" />
  </cloud-backup>
  <device-transfer>
    <include domain="file" path="." />
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="tohid-sync.xml" />
    <exclude domain="sharedpref" path="tohid-session.xml" />
    <exclude domain="sharedpref" path="tohid-session-secure.xml" />
    <exclude domain="sharedpref" path="tohid-staff-pins.xml" />
    <exclude domain="sharedpref" path="tohid-doc-series.xml" />
    <exclude domain="sharedpref" path="tohid-sync-v1.xml" />
    <exclude domain="sharedpref" path="tohid-backup-device.xml" />
    <exclude domain="file" path="sync-shadow" />
    <exclude domain="file" path="sync-v3" />
  </device-transfer>
</data-extraction-rules>
