<?xml version="1.0" encoding="utf-8"?>
<!-- فقط همین دو پوشهٔ کَش، نه کلِ حافظهٔ برنامه: هر برنامهٔ بیرونی
     (نصب‌کننده، دوربین) دقیقاً به همان یک فایلی دسترسی دارد که
     خودمان همان لحظه برایش ساخته‌ایم -->
<paths>
  <cache-path name="updates" path="updates/" />
  <!-- عکسی که برنامهٔ دوربین می‌گیرد، پیش از کوچک شدن و ذخیره‌ی نهایی.
       پوشه پیش از هر عکس خالی می‌شود، پس بیشتر از یک فایل داخلش نیست -->
  <cache-path name="camera" path="camera/" />
</paths>
