+ */
+class RecoveryPhraseSecureWiringTest {
+
+  private fun src(rel: String): String =
+    listOf("", "../", "../../")
+      .map { File(it + rel) }.firstOrNull { it.isFile }?.readText() ?: error("$rel پیدا نشد (cwd=${File(".").absoluteFile})")
