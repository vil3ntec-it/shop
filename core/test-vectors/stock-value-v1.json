    },
    {
      "name": "بی ارزشِ دقیق همان مقدار × بهای واحد: ۳ × ۶٫۶۷ = ۲۰٫۰۱",
      "lines": [ { "id": "soap", "onHandMilli": 3000, "unitCostMinor": 667, "unitPriceMinor": 900 } ],
      "expect": {
        "costMinor": 2001, "retailMinor": 2700, "potentialProfitMinor": 699, "marginBp": 2589, "inStock": 1,
