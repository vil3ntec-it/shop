        "lines": [ { "id": "soap", "costMinor": 2001, "retailMinor": 2700 } ],
        "complete": true
      }
    },
    {
      "name": "ارزشِ دقیقِ ناجور (منفی) ⇒ «حساب نشد»",
      "lines": [ { "id": "soap", "onHandMilli": 3000, "unitCostMinor": 667, "unitPriceMinor": 900, "costValueMinor": -1 } ],
      "expect": {
        "costMinor": 0, "retailMinor": 0, "potentialProfitMinor": 0, "marginBp": null, "inStock": 1,
        "missingCost": [], "missingPrice": [], "belowCost": [], "negative": [], "outOfRange": ["soap"],
        "lines": [],
        "complete": false
      }
    },
    {
      "name": "موجودیِ منفی با ارزشِ دقیق هم فقط منفی است",
      "lines": [ { "id": "neg", "onHandMilli": -1000, "unitCostMinor": 667, "unitPriceMinor": 900, "costValueMinor": 500 } ],
      "expect": {
        "costMinor": 0, "retailMinor": 0, "potentialProfitMinor": 0, "marginBp": null, "inStock": 0,
        "missingCost": [], "missingPrice": [], "belowCost": [], "negative": ["neg"], "outOfRange": [],
        "lines": [],
        "complete": true
      }
    },
    {
      "name": "فقط ارزشِ دقیق (بهای واحدِ صفر) هم «بها دارد»: ۳۰۰ و ۱۰۰۰ ⇒ ۷۰٪",
      "lines": [ { "id": "blind", "onHandMilli": 2000, "unitCostMinor": 0, "unitPriceMinor": 500, "costValueMinor": 300 } ],
      "expect": {
        "costMinor": 300, "retailMinor": 1000, "potentialProfitMinor": 700, "marginBp": 7000, "inStock": 1,
        "missingCost": [], "missingPrice": [], "belowCost": [], "negative": [], "outOfRange": [],
        "lines": [ { "id": "blind", "costMinor": 300, "retailMinor": 1000 } ],
        "complete": true
      }
    },
    {
      "name": "ارزشِ دقیقِ صفر و بهای صفر ⇒ بی بها؛ بی سود، بی حاشیه",
      "lines": [ { "id": "z", "onHandMilli": 1000, "unitCostMinor": 0, "unitPriceMinor": 500, "costValueMinor": 0 } ],
      "expect": {
        "costMinor": 0, "retailMinor": 500, "potentialProfitMinor": 0, "marginBp": null, "inStock": 1,
        "missingCost": ["z"], "missingPrice": [], "belowCost": [], "negative": [], "outOfRange": [],
        "lines": [ { "id": "z", "costMinor": 0, "retailMinor": 500 } ],
        "complete": false
      }
    },
    {
      "name": "جمعِ بی‌سرریز: دو ارزشِ ۵×۱۰^۱۵ ⇒ سقفِ ۲^۵۳−۱",
      "lines": [
        { "id": "a", "onHandMilli": 1, "unitCostMinor": 1, "unitPriceMinor": 0, "costValueMinor": 5000000000000000 },
        { "id": "b", "onHandMilli": 1, "unitCostMinor": 1, "unitPriceMinor": 0, "costValueMinor": 5000000000000000 }
      ],
      "expect": {
        "costMinor": 9007199254740991, "retailMinor": 0, "potentialProfitMinor": 0, "marginBp": null, "inStock": 2,
        "missingCost": [], "missingPrice": ["a", "b"], "belowCost": [], "negative": [], "outOfRange": [],
        "lines": [ { "id": "a", "costMinor": 5000000000000000, "retailMinor": 0 }, { "id": "b", "costMinor": 5000000000000000, "retailMinor": 0 } ],
        "complete": false
      }
    },
    {
      "name": "عددِ بزرگ: سودِ ۲×۱۰^۱۱ از ۳×۱۰^۱۱ ⇒ ۶۶۶۷ (حاصل‌ضربِ بیسیس‌پوینت بالای ۲^۵۰)",
      "lines": [ { "id": "gold", "onHandMilli": 1000, "unitCostMinor": 100000000000, "unitPriceMinor": 300000000000 } ],
      "expect": {
        "costMinor": 100000000000, "retailMinor": 300000000000, "potentialProfitMinor": 200000000000, "marginBp": 6667, "inStock": 1,
        "missingCost": [], "missingPrice": [], "belowCost": [], "negative": [], "outOfRange": [],
        "lines": [ { "id": "gold", "costMinor": 100000000000, "retailMinor": 300000000000 } ],
        "complete": true
      }
    },
    {
      "name": "حاشیهٔ منفیِ نیمه رو به +∞: −۱ از ۲۰۰۰۰ = −۰٫۵ ⇒ ۰؛ −۳ = −۱٫۵ ⇒ −۱",
      "lines": [ { "id": "m", "onHandMilli": 1000, "unitCostMinor": 20001, "unitPriceMinor": 20000 } ],
      "expect": {
        "costMinor": 20001, "retailMinor": 20000, "potentialProfitMinor": -1, "marginBp": 0, "inStock": 1,
        "missingCost": [], "missingPrice": [], "belowCost": ["m"], "negative": [], "outOfRange": [],
        "lines": [ { "id": "m", "costMinor": 20001, "retailMinor": 20000 } ],
        "complete": true
      }
    },
    {
      "name": "حاشیهٔ منفی: −۳ از ۲۰۰۰۰ = −۱٫۵ ⇒ −۱",
      "lines": [ { "id": "m3", "onHandMilli": 1000, "unitCostMinor": 20003, "unitPriceMinor": 20000 } ],
      "expect": {
        "costMinor": 20003, "retailMinor": 20000, "potentialProfitMinor": -3, "marginBp": -1, "inStock": 1,
