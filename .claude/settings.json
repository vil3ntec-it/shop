{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'قاعدهٔ اسکیل‌ها (بندِ ۴ و ۷ِ CLAUDE.md): پیش از نخستین کار روی پروژه، هر سه اسکیل را با ابزارِ Skill بخوان: anthropic-skills:smart-coding-core و anthropic-skills:exact-implementation-pro-max و anthropic-skills:elite-product-engineering-ultimate-memory؛ یک بار در هر سیزن (و دوباره پس از compact)، و در همهٔ کارهای پروژه به کار ببر. چتِ معمولی: همان لحظه جواب بده، اسکیل نخوان و به پروژه دست نزن.'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.p8)",
      "Read(**/id_rsa*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/secrets/**)",
      "Read(**/secrets.json)",
      "Read(/server/data/**)",
      "Read(**/*.sql.gz)",
      "Read(**/*.sql.gz.enc)",
      "Read(**/*.pglite.tar.gz)",
      "Read(**/*.pglite.tar.gz.enc)",
      "Read(**/*.dump)",
      "Read(**/*.pgdump)",
      "Read(**/*.db)",
      "Read(**/*.sqlite)",
      "Read(**/*.sqlite3)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(!**/.env.example)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/*.p8)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ecdsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/secrets/**)",
      "Edit(**/secrets.json)",
      "Edit(/server/data/**)",
      "Edit(**/*.sql.gz)",
      "Edit(**/*.sql.gz.enc)",
      "Edit(**/*.pglite.tar.gz)",
      "Edit(**/*.pglite.tar.gz.enc)",
      "Edit(**/*.dump)",
      "Edit(**/*.pgdump)",
      "Edit(**/*.db)",
      "Edit(**/*.sqlite)",
      "Edit(**/*.sqlite3)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.netrc)",
      "Edit(~/.git-credentials)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.claude/.credentials.json)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(export -p)",
      "Bash(node scripts/create-admin.js *)",
      "Bash(node server/scripts/create-admin.js *)",
      "Bash(npm run create-admin *)"
    ]
  }
}
