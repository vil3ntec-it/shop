# ------------------------------------------------------------------
#  HTTPS، خودکار.
#
#  Caddy خودش از Let's Encrypt گواهی می‌گیرد و پیش از تمام شدنش تازه‌اش
#  می‌کند. کاری برای کردن نیست جز اینکه:
#
#    ۱) در .env بنویسید:  DOMAIN=api.example.com
#    ۲) در DNS یک رکورد A بسازید که همان نام را به IP این سرور بدهد
#    ۳) پورت‌های ۸۰ و ۴۴۳ روی سرور باز باشند
#    ۴) بالا بیاورید:  docker compose --profile tls up -d
#
#  پورت ۸۰ برای گرفتن گواهی لازم است، حتی اگر همه‌ی ترافیک روی ۴۴۳ برود.
#
#  با این کار، `api` دیگر مستقیم به اینترنت باز نیست: فقط Caddy به آن
#  می‌رسد و بیرون فقط HTTPS می‌بیند.
# ------------------------------------------------------------------
{$DOMAIN} {
	encode zstd gzip

	# سرآیندهایی که فقط پشت HTTPS معنی دارند
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy api:3000 {
		# بدون این، سرور IP خودِ Caddy را IP کاربر می‌بیند و محدودیت
		# نرخ روی همه‌ی کاربرها با هم اعمال می‌شود. کنارش در .env باید
		# TRUST_PROXY=true باشد.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
