# ---------------------------------------------------------------
#  نمونه‌ی تنظیمات سرور فروشگاه
#  این فایل را به .env کپی کنید و مقدارها را عوض کنید.
#  هیچ‌کدام از این‌ها داخل کد نوشته نشده‌اند، پس همین سرور روی
#  کامپیوتر خانگی، VPS، سرور اختصاصی یا هاست Node.js کار می‌کند.
# ---------------------------------------------------------------

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# آدرسی که برنامه‌ها با آن به سرور می‌رسند (IP هم قبول است) — نامِ دومش PUBLIC_URL
# مثال: https://shop.example.com   (در GET /api/v1/config/server به‌عنوانِ publicUrl می‌آید)
SERVER_URL=
# نامی که برنامه‌ها در «سرورها» نشان می‌دهند (خالی ⇒ brand_name یا «سرورِ فروشگاه»)
SERVER_NAME=

# HTTPS ِ مستقیم، بی Caddy — برای سرورِ شبکهٔ دکان (docs/SERVERS-fa.md).
# برنامه‌ها http را در شبکه نمی‌پذیرند؛ گواهیِ خودامضا کافی است و در برنامه سنجاق می‌شود.
# یا PEM:  TLS_CERT_FILE + TLS_KEY_FILE   یا ویندوز:  TLS_PFX_FILE (+ TLS_PFX_PASSPHRASE)
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_PFX_FILE=
TLS_PFX_PASSPHRASE=

# ---------------- دیتابیس ----------------
DATABASE_URL=postgres://shop:CHANGE_ME@127.0.0.1:5432/shop
# بی PostgreSQL و بی داکر (کامپیوترِ خانگیِ ویندوز): همان PostgreSQL داخلِ خودِ
# Node (PGlite) با یک پوشه روی دیسک. پنلِ سرورِ خانگی خودش با همین بالا می‌آوردش.
#   DATABASE_URL=pglite:./data/pg
PG_POOL_MAX=10
# پس‌زدن زیرِ بار (PERF-04): هر انتظار برای اتصالِ استخر تا PG_CONNECT_TIMEOUT_MS (پیش‌فرض ۱۰۰۰۰)، بعد ۵۰۳ ِ db_busy.
# PG_POOL_MAX_WAITING > 0 ⇒ وقتی همین‌قدر در صفِ استخر منتظرند، تازه‌وارد بی‌درنگ ۵۰۳ می‌گیرد (پیش‌فرض ۰ = بی سقف).
# PG_CONNECT_TIMEOUT_MS=10000
# PG_POOL_MAX_WAITING=0
# دروازهٔ push ِ Sync v3 (فقط PostgreSQL): صفِ هر دکان و سقفِ push ِ هم‌زمان پیش از گرفتنِ اتصال.
# SYNC_V3_PUSH_SLOTS پیش‌فرض نیمِ PG_POOL_MAX (۰ = بی سقف)؛ انتظار تا SYNC_V3_GATE_WAIT_MS و حداکثر
# SYNC_V3_GATE_QUEUE_MAX منتظر، بعد ۵۰۳ ِ db_busy. SYNC_V3_GATE=false همان رفتارِ پیشین (فقط قفلِ پایگاه).
# SYNC_V3_PUSH_SLOTS=5
# SYNC_V3_GATE_WAIT_MS=8000
# SYNC_V3_GATE_QUEUE_MAX=200
# قفلِ گاوصندوق: پیش‌فرض local (سرورِ تک‌نمونه؛ فقط صفِ همین فرآیند، بی اتصالِ اضافه).
# چند نمونهٔ سرور روی یک پایگاه ⇒ حتماً db (قفلِ advisory روی استخرِ جدای SAFE_LOCK_POOL_MAX اتصال)؛
# بی آن، دو نمونه می‌توانند یک ردیفِ گاوصندوق را هم‌زمان دو بار بپذیرند.
# SAFE_LOCK_SCOPE=db
# SAFE_LOCK_POOL_MAX=10
# اگر سرور دیتابیس SSL می‌خواهد (سرویس‌های ابری) این را روشن کنید
PGSSL=false

# ---------------- رازها ----------------
# با این دستور بسازید:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_SECRET=
JWT_SECRET=
OTP_SECRET=
# کلیدِ امضای مجوز (ES256) — ⛔ همان کلیدِ امروزِ سرور، هرگز کلیدِ تازه (مجوزِ همهٔ نصب‌ها رد می‌شود).
# بیرون آوردنِ خطِ آماده:  node scripts/license-key.js export license.env   (docs/OWNER-DECISIONS-fa.md، O-18)
# خالی ⇒ ردیفِ پایگاه‌داده (رفتارِ پیشین)؛ هیچ‌کدام در production ⇒ صدورِ مجوز ۵۰۳ ِ license_key_missing، نه کلیدِ تازه.
# فقط سرورِ کاملاً نو (هرگز مجوز نداده):  node scripts/license-key.js generate license.env   — هر ردِ کلیدِ پیشین ⇒ نمی‌سازد.
LICENSE_PRIVATE_KEY=
# یا نشانیِ فایلِ PEM (حالتِ 600):
LICENSE_PRIVATE_KEY_FILE=

# ---------------- طول عمر نشست ----------------
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=90
ADMIN_TOKEN_TTL_HOURS=12

# ---------------- کد یک‌بارمصرف ----------------
# log      = کد در لاگ سرور چاپ می‌شود (سرور خانگی، بدون سرویس پیامک)
# webhook  = به آدرس OTP_WEBHOOK_URL فرستاده می‌شود (هر سرویس پیامکی)
OTP_PROVIDER=log
OTP_WEBHOOK_URL=
OTP_WEBHOOK_KEY=
OTP_DIGITS=6
OTP_TTL_MIN=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=120
OTP_DAILY_MAX=20
# SEC-06 — سقفِ هزینهٔ روزانهٔ پیامک (واحدِ خُرد، همان بهای واحدِ پنل × تکه) در ۲۴ ساعت، برای هر کانال.
# ۰ = خاموش. پر شدن ⇒ ۴۲۹ و راهِ ایمیل باز می‌ماند.
OTP_SMS_DAILY_COST_MAX_MINOR=0
OTP_SMS_SHOP_DAILY_COST_MAX_MINOR=0
DEFAULT_COUNTRY_CODE=+93

# ---------------- سرویس پیامک ----------------
# راهنمای کامل با نمونه: SMS.md
# OTP_PROVIDER را روی sms بگذارید تا این‌ها خوانده شوند.
SMS_API_URL=
SMS_API_METHOD=POST
SMS_API_KEY=
SMS_SENDER=
# JSON — جاگذاری‌ها: {to} {code} {message} {sender} {key}
SMS_API_HEADERS=
SMS_API_BODY=
# اگر سرویس قالب تأییدشده می‌خواهد
SMS_TEMPLATE=

# راه فرستادن کد برای ایمیل: log | email
OTP_EMAIL_PROVIDER=log

# ---------------- واتساپ (WhatsApp Cloud API رسمی Meta) ----------------
# از شماره‌ی واتساپ شخصی نمی‌شود کد فرستاد؛ حساب Business لازم است.
# اینها فقط اینجا می‌مانند و هرگز داخل برنامه‌ی گوشی نمی‌روند.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=otp_login
WHATSAPP_LANG=fa

# ---------------- ایمیل ----------------
# هر سرویسی که API با کلید دارد (Resend، Brevo، Mailgun…)
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_SUBJECT=کد ورود توحید

# ---------------- ورود با گوگل ----------------
# شناسه‌ی کلاینتِ **Web application** (نه Android) — راهنما: GOOGLE-LOGIN.md
# اگر خالی باشد، دکمه‌ی ورود با گوگل در برنامه نشان داده نمی‌شود
GOOGLE_CLIENT_ID=

# ---------------- پشتیبان‌گیری ----------------
BACKUP_ENABLED=true
BACKUP_PATH=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# «سلامت» زرد اگر آخرین تمرینِ بازیابیِ موفق (npm run restore-drill) کهنه‌تر از این چند روز باشد؛ ۰ = خاموش
BACKUP_DRILL_MAX_DAYS=31
# اگر پر باشد، فایل پشتیبان رمزنگاری می‌شود (این عبارت را گم نکنید)
BACKUP_PASSPHRASE=
# F0-28: رازهای app_config (کلیدِ مجوز، ایمیل، پیامک، پوش، کلیدِ پمپ) در پشتیبان: plain (پیش‌فرض، همان امروز) یا seal.
# seal ⇒ با کلیدِ زیر مهر می‌شوند (۶۴ hex، base64 ِ ۳۲ بایت یا ≥ ۳۲ نویسه)؛ کلید را بیرون از سرور هم نگه دارید.
# بی همین کلید پشتیبان برمی‌گردد ولی رازها مهر می‌مانند (docs/spec/OWNER-ACTIONS-fa.md §۳ گامِ ۸).
BACKUP_SECRETS=plain
BACKUP_SECRETS_KEY=
# BACKUP_SECRETS_KEY_FILE=/run/secrets/backup-secrets.key

# ---------------- دامنه و HTTPS ----------------
# نام دامنه‌ای که خریده‌اید و در DNS یک رکورد A به IP این سرور دارد.
# با پر بودنش و `docker compose --profile tls up -d`، گواهی HTTPS
# خودکار گرفته و تازه می‌شود. خالی یعنی بدون HTTPS — فقط برای شبکه‌ی محلی.
DOMAIN=
# API فقط روی خود سرور شنیده می‌شود و راه بیرون از Caddy می‌گذرد.
# اگر بدون دامنه روی شبکه‌ی محلی کار می‌کنید، 0.0.0.0 بگذارید.
BIND=127.0.0.1

# ---------------- امنیت ----------------
# دامنه‌های نسخه‌ی وب، با کاما. برنامه‌ی اندروید به این نیازی ندارد.
# مثال: https://vil3ntec-it.github.io
CORS_ORIGIN=
ALLOW_REGISTRATION=true
# پشت Caddy/Nginx/Cloudflare حتماً true — وگرنه سرور IP خود proxy را
# IP همه‌ی کاربرها می‌بیند و محدودیت نرخ روی همه با هم اعمال می‌شود
TRUST_PROXY=false
RATE_AUTH_MAX=10
RATE_OTP_MAX=5
LOGIN_LOCKOUT_TRIES=8
LOGIN_LOCKOUT_MIN=15

# ---------------- اشتراک ----------------
# مدتِ دورهٔ آزمایشی این‌جا نیست: پنلِ مدیر ⇒ تنظیمات (app_config.trial_days)،
# پیش‌فرض در src/lib/plans.js (TRIAL_DEFAULT). TRIAL_DAYS خوانده نمی‌شود.
DEFAULT_TIMEZONE=Asia/Kabul

# ── مدیر از محیط — برای نصبی که کسی پشتِ ترمینال نیست ─────────────────────
# اگر هر دو باشند، سرِ هر راه‌اندازی این مدیر ساخته (یا رمزش با این یکی) می‌شود.
# پنلِ سرورِ خانگی همین دو را می‌دهد و با همان به بخشِ «پمپ‌ها» وارد می‌شود.
# ADMIN_BOOTSTRAP_USER=admin
# ADMIN_BOOTSTRAP_PASSWORD=

# ── باتِ تلگرامِ پمپ (هشدارِ قرض‌دار و مخزن در تلگرام) ────────────────────
# معمولاً از پنلِ مدیر (تبِ «ایمیل و پوش») داده می‌شود و رمزشده در دیتابیس می‌ماند.
# اگر این‌جا باشد، جلوتر از پنل است. ⛔ هرگز داخلِ برنامهٔ کامپیوتر یا گوشی نه.
# TELEGRAM_BOT_TOKEN=
# دامنهٔ خودِ پمپ — لینکِ فایلِ نصبِ اندروید و صفحهٔ آیفون از همین ساخته می‌شود.
# PUMP_SITE_URL=https://yaqobipump.top

# ── اعلانِ وضعیتِ سفارش به مشتری (NTF-01، پرچمِ shop.customer_notify) ─────────
# نشانیِ عمومیِ ویترین‌ها تا لینکِ «سفارشِ من» در پیام بیاید: ‎<این>/<slug>#/o/<توکن>‎. فقط https؛ خالی ⇒ پیام بی لینک.
# STORE_PUBLIC_URL=https://vill3n.top/store

# ── حساب‌پیِ هر دکان (PAY-21، مهاجرتِ ۲۰۴) — شرح: docs/PAYMENTS-HESABPAY-fa.md ──────────
# پول مستقیم به حسابِ همان دکان؛ کلید و رازِ پذیرندهٔ هر دکان را صاحبِ همان دکان در «حساب‌پیِ دکان» می‌گذارد
# و سرور فقط رمزشده (AES-256-GCM) نگهشان می‌دارد. این کلیدِ رمزگذاری است — ۶۴ رقمِ hex یا ≥ ۳۲ نویسهٔ تصادفی،
# جدا از دیتابیس پشتیبان بگیرید. نبود ⇒ حالتِ «خودکار» برای همه خاموش (۵۰۳ ِ روشن)؛ «ساده» کار می‌کند.
# HESABPAY_CRED_KEY=
# فقط هنگامِ چرخشِ کلید: کلیدِ قبلی (فقط خواندن)
# HESABPAY_CRED_KEY_PREVIOUS=
# ⛔ HESABPAY_API_KEY / HESABPAY_WEBHOOK_SECRET / HESABPAY_MERCHANT_ID ِ سکو دیگر خوانده نمی‌شوند.

# ── پوشِ گوشی با Firebase (FCM، تصمیمِ O-01) — راهنمای گام‌به‌گام: docs/FIREBASE-SETUP-fa.md ─────────
# کلیدِ «حسابِ سرویس» ِ پروژهٔ Firebase (فایلِ JSON) — هرگز در مخزن. با docker compose: فایل را در server/secrets/
# بگذارید و مسیرِ **درونِ container** را این‌جا بنویسید. بی این، پوشِ اندروید خاموش است و سرور یک بار در لاگ می‌گوید.
# FCM_SERVICE_ACCOUNT_FILE=/app/secrets/fcm-service-account.json
# (یا خودِ JSON در یک خط: FCM_SERVICE_ACCOUNT=…  — فایل ساده‌تر و امن‌تر است)
