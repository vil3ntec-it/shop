# ---------------------------------------------------------------
#  نمونه‌ی تنظیمات سرور فروشگاه
#  این فایل را به .env کپی کنید و مقدارها را عوض کنید.
#  هیچ‌کدام از این‌ها داخل کد نوشته نشده‌اند، پس همین سرور روی
#  کامپیوتر خانگی، VPS، سرور اختصاصی یا هاست Node.js کار می‌کند.
# ---------------------------------------------------------------

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# آدرسی که برنامه‌ها با آن به سرور می‌رسند (IP هم قبول است)
# مثال: http://198.51.100.10:3000  یا  https://shop.example.com
SERVER_URL=

# ---------------- دیتابیس ----------------
DATABASE_URL=postgres://shop:CHANGE_ME@127.0.0.1:5432/shop
PG_POOL_MAX=10
# اگر سرور دیتابیس SSL می‌خواهد (سرویس‌های ابری) این را روشن کنید
PGSSL=false

# ---------------- رازها ----------------
# با این دستور بسازید:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_SECRET=
JWT_SECRET=
OTP_SECRET=

# ---------------- طول عمر نشست ----------------
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=90
ADMIN_TOKEN_TTL_HOURS=12

# ---------------- کد یک‌بارمصرف ----------------
# log      = کد در لاگ سرور چاپ می‌شود (سرور خانگی، بدون سرویس پیامک)
# webhook  = به آدرس OTP_WEBHOOK_URL فرستاده می‌شود (هر سرویس پیامکی)
OTP_PROVIDER=log
OTP_WEBHOOK_URL=
OTP_WEBHOOK_KEY=
OTP_DIGITS=6
OTP_TTL_MIN=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=120
OTP_DAILY_MAX=20
DEFAULT_COUNTRY_CODE=+93

# ---------------- سرویس پیامک ----------------
# راهنمای کامل با نمونه: SMS.md
# OTP_PROVIDER را روی sms بگذارید تا این‌ها خوانده شوند.
SMS_API_URL=
SMS_API_METHOD=POST
SMS_API_KEY=
SMS_SENDER=
# JSON — جاگذاری‌ها: {to} {code} {message} {sender} {key}
SMS_API_HEADERS=
SMS_API_BODY=
# اگر سرویس قالب تأییدشده می‌خواهد
SMS_TEMPLATE=

# راه فرستادن کد برای ایمیل: log | email
OTP_EMAIL_PROVIDER=log

# ---------------- واتساپ (WhatsApp Cloud API رسمی Meta) ----------------
# از شماره‌ی واتساپ شخصی نمی‌شود کد فرستاد؛ حساب Business لازم است.
# اینها فقط اینجا می‌مانند و هرگز داخل برنامه‌ی گوشی نمی‌روند.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=otp_login
WHATSAPP_LANG=fa

# ---------------- ایمیل ----------------
# هر سرویسی که API با کلید دارد (Resend، Brevo، Mailgun…)
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_SUBJECT=کد ورود توحید

# ---------------- ورود با گوگل ----------------
# شناسه‌ی کلاینتِ **Web application** (نه Android) — راهنما: GOOGLE-LOGIN.md
# اگر خالی باشد، دکمه‌ی ورود با گوگل در برنامه نشان داده نمی‌شود
GOOGLE_CLIENT_ID=

# ---------------- پشتیبان‌گیری ----------------
BACKUP_ENABLED=true
BACKUP_PATH=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# اگر پر باشد، فایل پشتیبان رمزنگاری می‌شود (این عبارت را گم نکنید)
BACKUP_PASSPHRASE=

# ---------------- دامنه و HTTPS ----------------
# نام دامنه‌ای که خریده‌اید و در DNS یک رکورد A به IP این سرور دارد.
# با پر بودنش و `docker compose --profile tls up -d`، گواهی HTTPS
# خودکار گرفته و تازه می‌شود. خالی یعنی بدون HTTPS — فقط برای شبکه‌ی محلی.
DOMAIN=
# API فقط روی خود سرور شنیده می‌شود و راه بیرون از Caddy می‌گذرد.
# اگر بدون دامنه روی شبکه‌ی محلی کار می‌کنید، 0.0.0.0 بگذارید.
BIND=127.0.0.1

# ---------------- امنیت ----------------
# دامنه‌های نسخه‌ی وب، با کاما. برنامه‌ی اندروید به این نیازی ندارد.
# مثال: https://vil3ntec-it.github.io
CORS_ORIGIN=
ALLOW_REGISTRATION=true
# پشت Caddy/Nginx/Cloudflare حتماً true — وگرنه سرور IP خود proxy را
# IP همه‌ی کاربرها می‌بیند و محدودیت نرخ روی همه با هم اعمال می‌شود
TRUST_PROXY=false
RATE_AUTH_MAX=10
RATE_OTP_MAX=5
LOGIN_LOCKOUT_TRIES=8
LOGIN_LOCKOUT_MIN=15

# ---------------- اشتراک ----------------
TRIAL_DAYS=14
DEFAULT_TIMEZONE=Asia/Kabul
