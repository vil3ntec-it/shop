# ---------------------------------------------------------------
#  نمونه‌ی تنظیمات سرور فروشگاه
#  این فایل را به .env کپی کنید و مقدارها را عوض کنید.
#  هیچ‌کدام از این‌ها داخل کد نوشته نشده‌اند، پس همین سرور روی
#  کامپیوتر خانگی، VPS، سرور اختصاصی یا هاست Node.js کار می‌کند.
# ---------------------------------------------------------------

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# آدرسی که برنامه‌ها با آن به سرور می‌رسند (IP هم قبول است)
# مثال: http://198.51.100.10:3000  یا  https://shop.example.com
SERVER_URL=

# ---------------- دیتابیس ----------------
DATABASE_URL=postgres://shop:CHANGE_ME@127.0.0.1:5432/shop
PG_POOL_MAX=10
# اگر سرور دیتابیس SSL می‌خواهد (سرویس‌های ابری) این را روشن کنید
PGSSL=false

# ---------------- رازها ----------------
# با این دستور بسازید:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_SECRET=
JWT_SECRET=
OTP_SECRET=

# ---------------- طول عمر نشست ----------------
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=90
ADMIN_TOKEN_TTL_HOURS=12

# ---------------- کد یک‌بارمصرف ----------------
# log      = کد در لاگ سرور چاپ می‌شود (سرور خانگی، بدون سرویس پیامک)
# webhook  = به آدرس OTP_WEBHOOK_URL فرستاده می‌شود (هر سرویس پیامکی)
OTP_PROVIDER=log
OTP_WEBHOOK_URL=
OTP_WEBHOOK_KEY=
OTP_DIGITS=6
OTP_TTL_MIN=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_DAILY_MAX=20
DEFAULT_COUNTRY_CODE=+93

# ---------------- ورود با گوگل ----------------
# Client ID های برنامه (اندروید و وب) با کاما
GOOGLE_CLIENT_ID=

# ---------------- پشتیبان‌گیری ----------------
BACKUP_ENABLED=true
BACKUP_PATH=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# اگر پر باشد، فایل پشتیبان رمزنگاری می‌شود (این عبارت را گم نکنید)
BACKUP_PASSPHRASE=

# ---------------- امنیت ----------------
# دامنه‌های نسخه‌ی وب، با کاما. برنامه‌ی اندروید به این نیازی ندارد.
CORS_ORIGIN=
ALLOW_REGISTRATION=true
# اگر پشت Nginx یا Cloudflare هستید true کنید تا IP واقعی دیده شود
TRUST_PROXY=false
RATE_AUTH_MAX=10
RATE_OTP_MAX=5
LOGIN_LOCKOUT_TRIES=8
LOGIN_LOCKOUT_MIN=15

# ---------------- اشتراک ----------------
TRIAL_DAYS=14
DEFAULT_TIMEZONE=Asia/Kabul
