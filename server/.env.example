# ============================================================
#  توحید | سرور اشتراک و License  —  نمونه پیکربندی
#  این فایل را به .env کپی کنید و مقادیر را تغییر دهید.
#  .env هرگز نباید در گیت کامیت شود.
# ============================================================

NODE_ENV=production
HOST=0.0.0.0
PORT=4700

# اگر سرور پشت nginx/cloudflare است، برای گرفتن IP واقعی روشن کنید
TRUST_PROXY=false

# --- مسیر داده‌ها ---
# DATA_DIR=/var/lib/tohid-license
# KEYS_DIR=/var/lib/tohid-license/keys
# DB_PATH=/var/lib/tohid-license/license.db

# --- License ---
LICENSE_ISSUER=tohid-license-server
LICENSE_AUDIENCE=tohid-shop-app

# --- پیش‌فرض اشتراک ---
DEFAULT_TIMEZONE=Asia/Kabul
DEFAULT_MAX_DEVICES=1
DEFAULT_GRACE_DAYS=0
# چند روز پس از صدور، برنامه باید دوباره Sync کند؟
# خالی بگذارید تا License تا پایان اشتراک بدون اینترنت معتبر بماند.
DEFAULT_LICENSE_TTL_DAYS=

# --- توکن‌ها ---
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=60
ADMIN_TOKEN_TTL_HOURS=12

# --- محدودیت نرخ ---
RATE_WINDOW_MS=900000
RATE_AUTH_MAX=10
RATE_GENERAL_MAX=300
LOGIN_LOCKOUT_TRIES=8
LOGIN_LOCKOUT_MIN=15

# --- دامنه‌هایی که برنامه از آن‌ها باز می‌شود (با کاما جدا کنید) ---
# خالی = فقط درخواست‌های same-origin و بدون Origin پذیرفته می‌شوند
CORS_ORIGINS=https://vil3ntec-it.github.io

# ثبت‌نام آزاد کاربران جدید
ALLOW_REGISTRATION=true
