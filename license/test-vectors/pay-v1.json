{
  "version": 1,
  "about": "بردارهای مرجعِ پرداخت و صندوق (PAY-01..07، 09..16، 19، 23). هر مبلغ عددِ صحیح به پول (۱۰۰ = یک افغانی). کاتلین (core/pay) و JS (license/pay-core.js) هر دو باید همهٔ این‌ها را بگذرانند. عددها دستی و از روی قاعده نوشته شده‌اند، نه از خروجیِ کد.",
  "constants": {
    "notes": [1000, 2000, 5000, 10000, 50000, 100000],
    "coins": [100, 200, 500],
    "defaultVarianceThreshold": 5000,
    "statuses": ["pending", "confirmed", "failed", "cancelled", "needs_review", "refunded", "partially_refunded"],
    "transitions": {
      "pending": ["confirmed", "failed", "cancelled", "needs_review"],
      "needs_review": ["confirmed", "failed", "cancelled"],
      "confirmed": ["partially_refunded", "refunded"],
      "partially_refunded": ["partially_refunded", "refunded"],
      "failed": [], "cancelled": [], "refunded": []
    },
    "moveReasons": { "cash_in": ["deposit", "other"], "cash_out": ["owner_withdrawal", "petty_expense", "other"] },
    "defaultMethods": [
      { "id": "cash", "kind": "cash", "name": "نقد", "needsRef": false, "limit": null, "enabled": true },
      { "id": "hesabpay", "kind": "wallet", "name": "HesabPay", "needsRef": true, "limit": null, "enabled": true },
      { "id": "e_money", "kind": "wallet", "name": "e& money", "needsRef": true, "limit": null, "enabled": true },
      { "id": "my_money", "kind": "wallet", "name": "My Money", "needsRef": true, "limit": null, "enabled": true },
      { "id": "atoma_pay", "kind": "wallet", "name": "ATOMA Pay", "needsRef": true, "limit": 1500000, "enabled": true },
      { "id": "m_paisa", "kind": "wallet", "name": "M-Paisa", "needsRef": true, "limit": null, "enabled": true },
      { "id": "afpay_card", "kind": "card", "name": "کارت AfPay", "needsRef": true, "limit": null, "enabled": true },
      { "id": "hawala", "kind": "transfer", "name": "حواله", "needsRef": true, "limit": null, "enabled": true },
      { "id": "store_credit", "kind": "store_credit", "name": "اعتبار فروشگاه", "needsRef": false, "limit": null, "enabled": false },
      { "id": "gift_card", "kind": "gift_card", "name": "کارت هدیه", "needsRef": true, "limit": null, "enabled": false }
    ]
  },
  "transitionErrors": [
    { "from": "paid", "to": "confirmed", "expect": { "ok": false, "error": "BAD_STATUS" } },
    { "from": "pending", "to": "refunded", "expect": { "ok": false, "error": "BAD_TRANSITION" } },
    { "from": "pending", "to": "confirmed", "expect": { "ok": true, "status": "confirmed" } }
  ],
  "methodTables": [
    { "name": "جدولِ دکان: نقد و بانک", "input": [{ "id": "cash", "kind": "cash", "name": "نقد" }, { "id": "bank", "kind": "transfer", "name": "بانک", "needsRef": false }],
      "expect": { "ok": true, "methods": [
        { "id": "cash", "kind": "cash", "name": "نقد", "needsRef": false, "limit": null, "enabled": true },
        { "id": "bank", "kind": "transfer", "name": "بانک", "needsRef": false, "limit": null, "enabled": true } ] } },
    { "name": "نقد هرگز شمارهٔ مرجع نمی‌خواهد؛ روشِ خاموش می‌ماند", "input": [{ "id": "cash", "kind": "cash", "name": "نقد", "needsRef": true }, { "id": "mp", "kind": "wallet", "name": "M-Paisa", "needsRef": true, "limit": 100000, "enabled": false }],
      "expect": { "ok": true, "methods": [
        { "id": "cash", "kind": "cash", "name": "نقد", "needsRef": false, "limit": null, "enabled": true },
        { "id": "mp", "kind": "wallet", "name": "M-Paisa", "needsRef": true, "limit": 100000, "enabled": false } ] } },
    { "name": "شناسهٔ تکراری", "input": [{ "id": "cash", "kind": "cash", "name": "نقد" }, { "id": "cash", "kind": "wallet", "name": "x" }], "expect": { "ok": false, "error": "BAD_METHOD", "index": 1 } },
    { "name": "account رزرو است", "input": [{ "id": "cash", "kind": "cash", "name": "نقد" }, { "id": "account", "kind": "other", "name": "حساب" }], "expect": { "ok": false, "error": "BAD_METHOD", "index": 1 } },
    { "name": "نوعِ ناشناخته", "input": [{ "id": "cash", "kind": "cash", "name": "نقد" }, { "id": "btc", "kind": "crypto", "name": "BTC" }], "expect": { "ok": false, "error": "BAD_METHOD", "index": 1 } },
    { "name": "نامِ خالی", "input": [{ "id": "cash", "kind": "cash", "name": "  " }], "expect": { "ok": false, "error": "BAD_METHOD", "index": 0 } },
    { "name": "سقفِ صفر", "input": [{ "id": "cash", "kind": "cash", "name": "نقد" }, { "id": "w", "kind": "wallet", "name": "w", "limit": 0 }], "expect": { "ok": false, "error": "BAD_METHOD", "index": 1 } },
    { "name": "دو روشِ نقد", "input": [{ "id": "cash", "kind": "cash", "name": "نقد" }, { "id": "cash2", "kind": "cash", "name": "دخلِ دوم" }], "expect": { "ok": false, "error": "BAD_METHOD", "index": -1 } },
    { "name": "بی نقد", "input": [{ "id": "w", "kind": "wallet", "name": "w" }], "expect": { "ok": false, "error": "BAD_METHOD", "index": -1 } }
  ],
  "settle": [
