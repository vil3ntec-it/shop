        "payments": [{ "method": "cash", "kind": "cash", "amount": 137000, "ref": null, "status": "confirmed" }] } },
    { "name": "دکمه‌های اسکناس روی هم جمع می‌شوند", "input": { "total": 137000, "tenders": [{ "method": "cash", "amount": 100000 }, { "method": "cash", "amount": 50000 }] },
      "expect": { "ok": true, "status": "paid", "total": 137000, "rounding": 0, "due": 137000, "tendered": 150000, "change": 13000, "remaining": 0, "toAccount": 0,
