        {"qtyMilli": 3000, "includeExpired": true, "expect": {"picks": [{"lotId": "e", "qtyMilli": 700}, {"lotId": "b", "qtyMilli": 1000}, {"lotId": "a", "qtyMilli": 1000}, {"lotId": "z", "qtyMilli": 300}], "shortMilli": 0}},
