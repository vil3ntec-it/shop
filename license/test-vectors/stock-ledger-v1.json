      "lines": [{"productId": "p2", "qtyMilli": 1000, "lotId": "A"}],
      "expect": [{"ok": true, "costMinor": 1000, "picks": [{"location": "", "lotId": "A", "qtyMilli": 1000}]}]},
    {"name": "lines of one product are checked one after another", "today": "2026-10-15",
      "lines": [{"productId": "p1", "qtyMilli": 6000}, {"productId": "p1", "qtyMilli": 5000}],
      "expect": [{"ok": true, "costMinor": 67999}, {"ok": false, "error": "insufficient_stock", "availableMilli": 4000}]},
    {"name": "stock in another location still sells (shelf first, then the store room)", "today": "2026-10-15",
      "lines": [{"productId": "p3", "qtyMilli": 2000}],
      "expect": [{"ok": true, "costMinor": 4000, "picks": [{"location": "انبار", "lotId": "L1", "qtyMilli": 2000}]}]},
    {"name": "never stocked -> insufficient_stock with nothing available", "today": "2026-10-15",
      "lines": [{"productId": "nope", "qtyMilli": 1000}],
      "expect": [{"ok": false, "error": "insufficient_stock", "availableMilli": 0}]}
